# === WhatsApp Cloud API (Meta) ===
# Los sacas del panel de developers.facebook.com > tu app > WhatsApp > Configuracion de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventala vos, es una palabra secreta que vos elegis para verificar el webhook
WHATSAPP_VERIFY_TOKEN=elegi-una-palabra-secreta
# "Clave secreta de la app" (App Secret), sirve para validar que los mensajes vienen de Meta
WHATSAPP_APP_SECRET=
# Numero de telefono de tu mama en formato internacional sin + ni espacios (ej 5493511234567)
# para el boton de "hablar con una persona"
OWNER_WHATSAPP_NUMBER=

# === Google (Calendar + Sheets, viven dentro de Drive) ===
# Salen de la cuenta de servicio que crees en Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# ID del calendario compartido con la cuenta de servicio (o "primary" si es el calendario principal)
GOOGLE_CALENDAR_ID=
# ID de la planilla de Google Sheets (esta en la URL de la planilla)
GOOGLE_SHEET_ID=

# === Panel privado de mama (usuario y contrasena que ella va a usar para entrar a /admin) ===
ADMIN_USER=mama
ADMIN_PASSWORD=elegi-una-contrasena-segura

# === Dashboard de finanzas (/finanzas) y su sincronizacion con Notion ===
# Todo esto es OPCIONAL: sin estas variables el dashboard funciona igual, con los
# datos guardados solo en el navegador. Cargalas si querés sincronizar con Notion.
#
# 1) Clave que el dashboard manda al servidor para poder sincronizar. Inventala vos
#    (algo largo y random) y despues pegala en el dashboard: Configuracion > Notion.
FINANZAS_TOKEN=
# 2) Token de la integracion interna de Notion (https://www.notion.so/my-integrations).
#    Empieza con ntn_ o secret_. Nunca sale del servidor.
NOTION_TOKEN=
# 3) ID de la base "Movimientos" en Notion (el bloque de 32 caracteres de su URL).
NOTION_DB_MOVIMIENTOS=8bf9818ad9d648b1884b5a2742295af3
# 4) Opcional: pagina donde crear la base automaticamente (POST /api/finanzas/crear-base)
NOTION_PARENT_PAGE_ID=

PORT=3000
